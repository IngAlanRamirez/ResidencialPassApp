<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: icono transparente para evitar el recorte circular.
         El fondo mostrará el color; la imagen completa se ve en el overlay de la app. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
